<div id="digital-rain" class="digital-rain" aria-hidden="true"></div>

<script is:inline>
  (() => {
    const layer = document.getElementById('digital-rain');
    if (!(layer instanceof HTMLElement)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const frame = layer.closest('.home-frame');
    if (!(frame instanceof HTMLElement)) return;

    const streams = [];
    let animationFrame;
    let lastFrame = performance.now();
    let width = 0;
    let height = 0;

    function random(min, max) {
      return min + Math.random() * (max - min);
    }

    function createStream() {
      const blockCount = Math.floor(random(6, 25));
      const stream = document.createElement('div');
      stream.className = 'digital-rain__stream';
      const brightHead = Math.random() > .82;

      for (let index = 0; index < blockCount; index += 1) {
        const block = document.createElement('i');
        const fade = 1 - index / blockCount;
        const alpha = Math.max(.06, random(.12, .34) * fade + (brightHead && index < 2 ? .45 * (1 - index * .5) : 0));
        block.style.opacity = String(alpha);
        stream.append(block);
      }

      layer.append(stream);
      return {
        element: stream,
        x: Math.round(random(0, Math.max(0, width - 4))),
        y: random(-height, height),
        speed: random(7, 21),
        height: blockCount * 8 - 4,
      };
    }

    function reset(stream) {
      stream.x = Math.round(random(0, Math.max(0, width - 4)));
      stream.y = -stream.height - random(40, height * .8);
      stream.speed = random(7, 21);
      stream.element.style.left = `${stream.x}px`;
    }

    function setup() {
      const bounds = layer.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      streams.splice(0).forEach((stream) => stream.element.remove());
      const count = Math.max(30, Math.floor(width / 17));
      for (let index = 0; index < count; index += 1) {
        const stream = createStream();
        stream.element.style.left = `${stream.x}px`;
        streams.push(stream);
      }
    }

    function draw(now) {
      const elapsed = Math.min(50, now - lastFrame) / 1000;
      lastFrame = now;
      streams.forEach((stream) => {
        stream.y += stream.speed * elapsed;
        if (stream.y > height + 8) reset(stream);
        stream.element.style.transform = `translate3d(0, ${stream.y}px, 0)`;
      });
      animationFrame = requestAnimationFrame(draw);
    }

    function start() {
      setup();
      animationFrame = requestAnimationFrame(draw);

      const observer = new ResizeObserver(() => {
        setup();
        lastFrame = performance.now();
      });
      observer.observe(frame);

      addEventListener('resize', () => {
        setup();
        lastFrame = performance.now();
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>
