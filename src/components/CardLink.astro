---
const {
  href,
  title,
  description,
  site,
  image,
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="
    group flex overflow-hidden rounded-xl
    border border-zinc-800
    bg-zinc-900 hover:bg-zinc-800
    transition-colors
  "
>
  {/* 左側 */}
  <div class="flex-1 p-4">
    <h3 class="text-lg font-semibold text-zinc-100 mb-1 line-clamp-2">
      {title}
    </h3>
    <p class="text-sm text-zinc-400 line-clamp-2 mb-3">
      {description}
    </p>

    <div class="flex items-center gap-2 text-xs text-zinc-500">
      <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.09-.745.082-.73.082-.73 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.807 1.305 3.492.998.108-.776.42-1.305.763-1.605-2.665-.304-5.467-1.332-5.467-5.93 0-1.31.47-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3-.404c1.02.005 2.045.138 3 .404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.624-5.48 5.92.432.372.816 1.103.816 2.222 0 1.604-.015 2.896-.015 3.286 0 .322.216.694.825.576C20.565 21.796 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>{site}</span>
    </div>
  </div>

  {/* 右側 OGP */}
  {image && (
    <div class="w-40 shrink-0 bg-zinc-800">
      <img
        src={image}
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
  )}
</a>
