---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, getPostPath, getReadingTime } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => {
    const formattedDate = formatPostDate(post.data.pubDate);
    const readingTime = getReadingTime(post);

    return (
      <article class="post-list-item">
        <a href={getPostPath(post)} class="post-list-link">
          <div class="post-meta-line">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <span class="post-reading">{readingTime}</span>
          </div>

          <div class="post-copy">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      </article>
    );
  })}
</div>

<style>
  .post-list {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    border-top: 1px solid var(--line);
    background: rgb(10 10 10 / .5);
  }

  .post-list-item {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .post-list-link {
    display: grid;
    grid-template-columns: minmax(7.5rem, 9rem) minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.55rem 2.25rem 1.55rem 0;
    border-radius: 2px;
    text-decoration: none;
  }

  .post-list-link:hover h3,
  .post-list-link:focus-visible h3 {
    color: var(--list-accent);
  }

  .post-list-link:focus-visible {
    outline: 2px solid var(--list-accent);
    outline-offset: -2px;
  }

  .post-meta-line {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .35rem;
  }

  .post-date,
  .post-reading {
    color: var(--muted);
    font: 500 .69rem/1.45 var(--mono);
    letter-spacing: .045em;
    text-transform: uppercase;
  }

  .post-reading {
    display: inline-flex;
    align-items: center;
  }

  .post-list h3 {
    margin: 0;
    max-width: 40rem;
    font: 600 clamp(1.2rem, 1.12rem + .3vw, 1.4rem)/1.28 var(--sans);
    letter-spacing: -.035em;
    transition: color .18s ease;
  }

  .post-list p {
    display: -webkit-box;
    margin: .5rem 0 0;
    max-width: 62ch;
    overflow: hidden;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  @media (min-width: 900px) {
    .post-list {
      padding-right: max(1.125rem, calc((100% - 45rem) / 2));
      padding-left: max(1.125rem, calc((100% - 45rem) / 2));
    }
  }

  @media (max-width: 640px) {
    .post-list-link {
      grid-template-columns: 1fr;
      gap: .7rem;
      padding: 1.5rem 0;
    }

    .post-list h3 {
      margin-top: 0;
      font-size: 1.25rem;
    }

    .post-list p {
      -webkit-line-clamp: 2;
    }
  }
</style>
