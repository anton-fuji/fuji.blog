---
interface Props {
  label: string;
  href?: string;
  kind?: 'meta' | 'tag';
}

const { label, href, kind = 'tag' } = Astro.props;

const classes = [
  'post-badge',
  kind === 'tag'
    ? 'post-badge-tag'
    : 'post-badge-meta',
];
---

{href ? (
  <a href={href} class:list={classes}>
    {kind === 'tag' && <span class="badge-hash">#</span>}
    <span>{label}</span>
  </a>
) : (
  <span class:list={classes}>
    {kind === 'tag' && <span class="badge-hash">#</span>}
    <span>{label}</span>
  </span>
)}
