---
interface Props {
  scope?: 'frame' | 'page';
}

const { scope = 'frame' } = Astro.props;
---

<canvas id="hero-rain" class:list={['hero__canvas', scope === 'page' && 'site-rain']} aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    const canvas = document.getElementById('hero-rain');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    let drops = [];
    let animationFrame;

    function setup() {
      const bounds = canvas.getBoundingClientRect();
      const scale = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(bounds.width * scale));
      canvas.height = Math.max(1, Math.floor(bounds.height * scale));
      context.setTransform(scale, 0, 0, scale, 0, 0);

      const count = Math.max(160, Math.floor(bounds.width / 6));
      drops = Array.from({ length: count }, () => ({
        x: Math.random() * bounds.width,
        y: Math.random() * bounds.height,
        length: 7 + Math.random() * 21,
        speed: 1.5 + Math.random() * 2.8,
        drift: .28 + Math.random() * .32,
        width: 1,
        opacity: .045 + Math.random() * .14,
      }));
    }

    function draw() {
      const bounds = canvas.getBoundingClientRect();
      // Fade each frame quickly enough to keep droplets short and rain-like.
      context.fillStyle = 'rgb(10 10 10 / 0.28)';
      context.fillRect(0, 0, bounds.width, bounds.height);

      for (const drop of drops) {
        context.beginPath();
        context.strokeStyle = `rgb(190 215 230 / ${drop.opacity})`;
        context.lineWidth = drop.width;
        context.moveTo(drop.x, drop.y);
        context.lineTo(drop.x - drop.drift * drop.length, drop.y + drop.length);
        context.stroke();
        drop.y += drop.speed;
        drop.x -= drop.drift;
        if (drop.y > bounds.height + drop.length) {
          drop.y = -drop.length;
          drop.x = Math.random() * bounds.width;
        }
      }
      animationFrame = requestAnimationFrame(draw);
    }

    setup();
    draw();
    addEventListener('resize', () => {
      cancelAnimationFrame(animationFrame);
      setup();
      draw();
    }, { passive: true });
  })();
</script>
