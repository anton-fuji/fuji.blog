---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="fuji.blog">
  <div class="mb-12">
    <p class="text-xl text-slate-600 dark:text-slate-400">
      技術と日常の記録
    </p>
  </div>
  
<div class="space-y-6">
  {posts.map((post) => {
    const formattedDate = `${post.data.pubDate.getFullYear()}-${post.data.pubDate.getMonth() + 1}-${post.data.pubDate.getDate()}`;
    
    return (
      <article class="border-b border-zinc-200 dark:border-zinc-800 pb-6 last:border-0">
        <a href={`/posts/${post.id}`} class="block group">
          {/* タイトルと日時を横並び */}
          <div class="flex justify-between items-baseline mb-2 gap-4">
<h2 class="text-xl font-bold text-zinc-800/50 dark:text-zinc-700 group-hover:text-zinc-900 dark:group-hover:text-indigo-400 transition-colors">
            {post.data.title}
          </h2>
            <time class="text-base text-zinc-500 dark:text-zinc-500 whitespace-nowrap flex-shrink-0" datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
          </div>
          
          {/* タグを下に配置 */}
          {post.data.tags.length > 0 && (
            <div class="flex gap-2 flex-wrap">
              {post.data.tags.map((tag) => (
          <span class="text-sm text-zinc-800/50 dark:text-zinc-700 group-hover:text-zinc-900 dark:group-hover:text-indigo-400 transition-colors">
                  # {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      </article>
    );
  })}
</div>
</BaseLayout>

