---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatPostDate, getPostLocale, getPostPath, getPostTranslationKey, getReadingTime } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const enPosts = posts.filter((post) => !post.data.draft && getPostLocale(post) === 'en');
  const allTags = [...new Set(enPosts.flatMap(post => post.data.tags))];

  return allTags.map(tag => {
    const taggedPosts = enPosts.filter(post => post.data.tags.includes(tag));
    const jaTag = posts
      .filter((post) => !post.data.draft && getPostLocale(post) === 'ja')
      .find((post) => taggedPosts.some((taggedPost) => getPostTranslationKey(taggedPost) === getPostTranslationKey(post)))
      ?.data.tags[0];

    return {
      params: { tag },
      props: {
        posts: taggedPosts,
        jaTag,
      }
    };
  });
}

const { tag } = Astro.params;
const { posts, jaTag } = Astro.props;
---

<BaseLayout title={`${tag} - fuji.blog`} lang="en" jaPath={jaTag ? `/tags/${jaTag}` : undefined} enPath={`/en/tags/${tag}`}>
  <section class="mb-12 border-b border-zinc-200/70 pb-8 dark:border-zinc-800/80">
    <p class="mb-4 font-mono text-xs uppercase text-zinc-500 dark:text-zinc-500">
      Tag index / {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
    <h1 class="text-4xl font-semibold text-zinc-900 dark:text-zinc-100">
      #{tag}
    </h1>
  </section>

  <div class="space-y-0">
    {posts.map((post) => {
      const formattedDate = formatPostDate(post.data.pubDate);
      const readingTime = getReadingTime(post);

      return (
        <article class="border-b border-zinc-200/70 dark:border-zinc-800/80">
          <a href={getPostPath(post)} class="group grid gap-3 py-6 transition-colors sm:grid-cols-[8rem_1fr] sm:gap-8">
            <time class="font-mono text-xs uppercase text-zinc-500 dark:text-zinc-500 sm:pt-1" datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>

            <div>
              <h2 class="text-xl font-semibold text-zinc-800 transition-colors group-hover:text-zinc-600 dark:text-zinc-100 dark:group-hover:text-zinc-300">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                {post.data.description}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-zinc-500 dark:text-zinc-500">
                <span>{readingTime}</span>
                {post.data.tags.filter(t => t !== tag).map(t => (
                  <span class="transition-colors group-hover:text-zinc-700 dark:group-hover:text-zinc-300">#{t}</span>
                ))}
              </div>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</BaseLayout>
