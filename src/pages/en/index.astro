---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, getPostPath, getPublishedPosts, getReadingTime } from '../../lib/posts';

const posts = getPublishedPosts(await getCollection('posts'), 'en');
---

<BaseLayout title="fuji.blog" lang="en" jaPath="/" enPath="/en">
  <section>
    <div class="border-b border-zinc-200/70 pb-5 dark:border-zinc-800/80">
      <h1 class="font-mono text-xs uppercase text-zinc-500 dark:text-zinc-500">
        Posts
      </h1>
    </div>

    <div class="space-y-0">
      {posts.map((post) => {
        const formattedDate = formatPostDate(post.data.pubDate);
        const readingTime = getReadingTime(post);

        return (
          <article class="border-b border-zinc-200/70 dark:border-zinc-800/80">
            <a href={getPostPath(post)} class="group grid gap-3 py-7 transition-colors sm:grid-cols-[8rem_1fr] sm:gap-8">
              <time class="font-mono text-xs uppercase text-zinc-500 dark:text-zinc-500 sm:pt-1" datetime={post.data.pubDate.toISOString()}>
                {formattedDate}
              </time>
              <div>
                <h2 class="text-2xl font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-zinc-600 dark:text-zinc-100 dark:group-hover:text-zinc-300">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  {post.data.description}
                </p>
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-zinc-500 dark:text-zinc-500">
                  <span>{readingTime}</span>
                  {post.data.tags.map((tag) => (
                    <span class="transition-colors group-hover:text-zinc-700 dark:group-hover:text-zinc-300">#{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
