            </svg>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-50">Qiita</div>
              <div class="font-mono text-sm text-zinc-600 dark:text-zinc-400">@fujifuji1414</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-zinc-400 transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="https://lapras.com/public/Fuuji"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
        >
          <div class="flex items-center gap-4">
            <img class="lapras-logo" src="https://assets.lapras.com/static/assets/bundles/media/logo-symbol.074fbd2e4ecdd6d4..svg" alt="LAPRAS" width="24" height="24" />
            <svg class="h-6 w-6 text-zinc-600 dark:text-zinc-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.779 0.025a11.789 11.789 0 0 0 -5.338 0.896A11.829 11.829 0 0 0 3.058 4.11 11.928 11.928 0 0 0 0.427 14.363a11.92 11.92 0 0 0 2.3 4.921 11.842 11.842 0 0 0 4.24 3.378 11.783 11.783 0 0 0 10.533 -0.226 0.327 0.327 0 0 1 0.331 0.018 9.136 9.136 0 0 0 5.197 1.545 0.332 0.332 0 0 0 0.332 -0.332v-4.038a0.334 0.334 0 0 0 -0.276 -0.331 4.732 4.732 0 0 1 -1.106 -0.319 0.329 0.329 0 0 1 -0.191 -0.352 0.33 0.33 0 0 1 0.05 -0.133 11.943 11.943 0 0 0 0.772 -11.871 11.87 11.87 0 0 0 -4.042 -4.628A11.793 11.793 0 0 0 12.765 0.018l0.013 0.007h0.001ZM4.843 11.898a7.24 7.24 0 0 1 1.205 -4.005 7.18 7.18 0 0 1 3.215 -2.657 7.133 7.133 0 0 1 7.815 1.558 7.239 7.239 0 0 1 1.555 7.854 7.202 7.202 0 0 1 -2.643 3.234 7.147 7.147 0 0 1 -9.049 -0.896 7.228 7.228 0 0 1 -2.103 -5.089l0.005 0.001Z"/>
            </svg>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-50">LAPRAS</div>
              <div class="font-mono text-sm text-zinc-600 dark:text-zinc-400">@Fuuji</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-zinc-400 transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
    </div>
  </div>
</BaseLayout>
