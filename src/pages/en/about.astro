---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DigitalRain from '../../components/DigitalRain.astro';
import { siQiita } from 'simple-icons';
---

<BaseLayout title="About - fuji.blog" description="About fuji.blog" lang="en" jaPath="/about" enPath="/en/about">
  <div class="about-frame rain-frame">
    <DigitalRain />
    <div class="about-page">
    <p class="about-portfolio-note">
      For more details, visit my <a href="https://fuuji.site" target="_blank" rel="noopener noreferrer">portfolio ↗</a>
    </p>
    <section>
      <h2 class="mb-6 font-mono text-sm uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
        Experience
      </h2>
      <div class="space-y-6">
        <div class="border-l-2 border-zinc-300 pl-4 dark:border-zinc-700">
          <div class="mb-1 flex items-baseline justify-between gap-4">
            <h3 class="font-bold text-zinc-900 dark:text-zinc-50">J.B.Goode Inc.</h3>
            <span class="shrink-0 font-mono text-sm text-zinc-500 dark:text-zinc-500">2025 - Present</span>
          </div>
          <p class="text-zinc-600 dark:text-zinc-400">Software Engineer</p>
        </div>
        <div class="border-l-2 border-zinc-300 pl-4 dark:border-zinc-700">
          <div class="mb-1 flex items-baseline justify-between gap-4">
            <h3 class="font-bold text-zinc-900 dark:text-zinc-50">Okayama Sozan High School</h3>
            <span class="shrink-0 font-mono text-sm text-zinc-500 dark:text-zinc-500">2021 - 2024</span>
          </div>
          <p class="text-zinc-600 dark:text-zinc-400">General Course</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="mb-6 font-mono text-sm uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
        Social Streams
      </h2>
      <div class="space-y-3">
        <a
          href="https://fuuji.site"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
        >
          <div class="flex items-center gap-4">
            <img class="portfolio-logo" src="/profile-ascii-transparent.png" alt="" width="24" height="24" />
            <svg class="h-6 w-6 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 4h6m0 0v6m0-6L10 14m-1-8H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" />
            </svg>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-50">Portfolio</div>
              <div class="font-mono text-sm text-zinc-600 dark:text-zinc-400">fuuji.site</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-zinc-400 transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="https://github.com/anton-fuji"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
        >
          <div class="flex items-center gap-4">
            <svg class="h-6 w-6 text-zinc-600 dark:text-zinc-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-50">GitHub</div>
              <div class="font-mono text-sm text-zinc-600 dark:text-zinc-400">@anton-fuji</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-zinc-400 transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="https://zenn.dev/fuuji"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
        >
          <div class="flex items-center gap-4">
            <svg class="h-6 w-6 text-zinc-600 dark:text-zinc-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M0.264 23.771h4.984c0.264 0 0.498 -0.147 0.645 -0.352L19.614 0.874c0.176 -0.293 -0.029 -0.645 -0.381 -0.645h-4.72c-0.235 0 -0.44 0.117 -0.557 0.323L0.03 23.361c-0.088 0.176 0.029 0.41 0.234 0.41zm17.181 -0.352 6.479 -10.408c0.205 -0.323 -0.029 -0.733 -0.41 -0.733h-4.691c-0.176 0 -0.352 0.088 -0.44 0.235l-6.655 10.643c-0.176 0.264 0.029 0.616 0.352 0.616h4.779c0.234 -0.001 0.468 -0.118 0.586 -0.353z"></path>
            </svg>
            <div>
              <div class="font-semibold text-zinc-900 dark:text-zinc-50">Zenn</div>
              <div class="font-mono text-sm text-zinc-600 dark:text-zinc-400">@fuuji</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-zinc-400 transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="https://qiita.com/fujifuji1414"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
        >
          <div class="flex items-center gap-4">
            <svg class="qiita-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siQiita.path} /></svg>
            <svg class="h-6 w-6 text-zinc-600 dark:text-zinc-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.57 8.343a3.653 3.653 0 0 0 -1.376 0.269 3.585 3.585 0 0 0 -1.14 0.738 3.503 3.503 0 0 0 -0.773 1.102A3.297 3.297 0 0 0 0 11.814a3.28 3.28 0 0 0 0.281 1.357 3.535 3.535 0 0 0 0.775 1.107A3.636 3.636 0 0 0 3.6 15.29a3.731 3.731 0 0 0 0.987 -0.13 3.657 3.657 0 0 0 0.888 -0.374l0.687 0.698a0.579 0.579 0 0 0 0.824 0 0.58 0.58 0 0 0 0 -0.817l-0.624 -0.624a3.533 3.533 0 0 0 0.613 -1.022 3.282 3.282 0 0 0 0.226 -1.208 3.297 3.297 0 0 0 -0.282 -1.362 3.488 3.488 0 0 0 -0.775 -1.102A3.614 3.614 0 0 0 5 8.612a3.657 3.657 0 0 0 -1.398 -0.27zm11.306 0.185v1.484h-0.765v1.063h0.765v2.142c0 0.419 0.053 0.761 0.159 1.028a1.56 1.56 0 0 0 0.433 0.63 1.511 1.511 0 0 0 0.643 0.317 2.676 2.676 0 0 0 0.694 0.086h0.853v-1.013h-0.736a1.25 1.25 0 0 1 -0.352 -0.048 0.713 0.713 0 0 1 -0.291 -0.169 0.81 0.81 0 0 1 -0.2 -0.324 1.575 1.575 0 0 1 -0.074 -0.519v-2.13h1.666v-1.063h-1.66V8.528zM9.4 8.856a0.69 0.69 0 0 0 -0.69 0.691 0.69 0.69 0 0 0 0.69 0.69 0.69 0.69 0 0 0 0.691 -0.69 0.69 0.69 0 0 0 -0.69 -0.691zm2.771 0a0.69 0.69 0 0 0 -0.69 0.691 0.69 0.69 0 0 0 0.69 0.69 0.69 0.69 0 0 0 0.691 -0.69 0.69 0.69 0 0 0 -0.69 -0.691zm-8.6 0.538a2.35 2.35 0 0 1 0.93 0.187 2.346 2.346 0 0 1 1.264 1.28 2.463 2.463 0 0 1 0.186 0.957 2.444 2.444 0 0 1 -0.186 0.957 2.384 2.384 0 0 1 -0.506 0.767 2.363 2.363 0 0 1 -1.688 0.698 2.324 2.324 0 0 1 -0.93 -0.186 2.376 2.376 0 0 1 -0.755 -0.512 2.427 2.427 0 0 1 -0.699 -1.723 2.44 2.44 0 0 1 0.699 -1.727 2.384 2.384 0 0 1 0.756 -0.511 2.324 2.324 0 0 1 0.898 -0.187zm17.648 0.773a2.69 2.69 0 0 0 -1.02 0.201 2.49 2.49 0 0 0 -0.815 0.552 2.432 2.432 0 0 0 -0.525 0.814 2.678 2.678 0 0 0 -0.186 0.998 2.644 2.644 0 0 0 0.186 0.997 2.485 2.485 0 0 0 0.525 0.814 2.436 2.436 0 0 0 0.815 0.546 2.697 2.697 0 0 0 1.059 0.2 2.42 2.42 0 0 0 0.518 -0.056 2.524 2.524 0 0 0 0.46 -0.146 2.426 2.426 0 0 0 0.394 -0.213 2.394 2.394 0 0 0 0.329 -0.263l0.065 0.53H24v-4.829h-0.976l-0.068 0.533a2.498 2.498 0 0 0 -0.322 -0.26 2.25 2.25 0 0 0 -0.394 -0.217 2.616 2.6