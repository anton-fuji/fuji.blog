---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPostLocale, getPostSlug, getTranslatedPost } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => getPostLocale(post) === 'en')
    .map((post) => ({
      params: { id: getPostSlug(post) },
      props: { post, posts },
    }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const translatedPost = getTranslatedPost(post, posts, 'ja');
const slug = getPostSlug(post);
---

<BlogPost {...post.data} slug={slug} headings={headings} post={post} lang="en" jaPath={translatedPost ? `/posts/${getPostSlug(translatedPost)}` : undefined} enPath={`/en/posts/${slug}`}>
  <Content />
</BlogPost>
