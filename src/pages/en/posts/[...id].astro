---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPostLocale, getPostSlug, getPublishedPosts, getTranslatedPost } from '../../../lib/posts';
import LinkCard from '../../../components/LinkCard.astro';
import Quote from '../../../components/Quote.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => getPostLocale(post) === 'en')
    .map((post) => ({
      params: { id: getPostSlug(post) },
      props: { post, posts },
    }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const translatedPost = getTranslatedPost(post, posts, 'ja');
const slug = getPostSlug(post);
const publishedPosts = getPublishedPosts(posts, 'en');
const currentIndex = publishedPosts.findIndex((candidate) => candidate.id === post.id);
const newerPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < publishedPosts.length - 1
  ? publishedPosts[currentIndex + 1]
  : undefined;
---

<BlogPost {...post.data} slug={slug} headings={headings} post={post} newerPost={newerPost} olderPost={olderPost} lang="en" jaPath={translatedPost ? `/posts/${getPostSlug(translatedPost)}` : undefined} enPath={`/en/posts/${slug}`}>
  <Content components={{ LinkCard, Quote }} />
</BlogPost>
