---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPostLocale, getPostTranslationKey } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const jaPosts = posts.filter((post) => !post.data.draft && getPostLocale(post) === 'ja');
  const allTags = [...new Set(jaPosts.flatMap(post => post.data.tags))];
  
  return allTags.map(tag => {
    const taggedPosts = jaPosts.filter(post => post.data.tags.includes(tag));
    const enTag = posts
      .filter((post) => !post.data.draft && getPostLocale(post) === 'en')
      .find((post) => taggedPosts.some((taggedPost) => getPostTranslationKey(taggedPost) === getPostTranslationKey(post)))
      ?.data.tags[0];

    return {
      params: { tag },
      props: {
        posts: taggedPosts,
        enTag,
      }
    };
  });
}

const { tag } = Astro.params;
const { posts, enTag } = Astro.props;
---

<BaseLayout title={`${tag} - fuji.blog`} lang="ja" jaPath={`/tags/${tag}`} enPath={enTag ? `/en/tags/${enTag}` : undefined}>
  <section class="tag-header">
    <p
      class="eyebrow"
      data-i18n-ja={`タグ / ${posts.length} 件`}
      data-i18n-en={`Tag index / ${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
    >
      タグ / {posts.length} 件
    </p>
    <h1>
      #{tag}
    </h1>
  </section>
  
  <PostList posts={posts} />
</BaseLayout>
