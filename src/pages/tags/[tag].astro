---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, getPostLocale, getPostPath, getPostTranslationKey, getReadingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const jaPosts = posts.filter((post) => !post.data.draft && getPostLocale(post) === 'ja');
  const allTags = [...new Set(jaPosts.flatMap(post => post.data.tags))];
  
  return allTags.map(tag => {
    const taggedPosts = jaPosts.filter(post => post.data.tags.includes(tag));
    const enTag = posts
      .filter((post) => !post.data.draft && getPostLocale(post) === 'en')
      .find((post) => taggedPosts.some((taggedPost) => getPostTranslationKey(taggedPost) === getPostTranslationKey(post)))
      ?.data.tags[0];

    return {
      params: { tag },
      props: {
        posts: taggedPosts,
        enTag,
      }
    };
  });
}

const { tag } = Astro.params;
const { posts, enTag } = Astro.props;
---

<BaseLayout title={`${tag} - fuji.blog`} lang="ja" jaPath={`/tags/${tag}`} enPath={enTag ? `/en/tags/${enTag}` : undefined}>
  <section class="tag-header">
    <p
      class="eyebrow"
      data-i18n-ja={`タグ / ${posts.length} 件`}
      data-i18n-en={`Tag index / ${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
    >
      タグ / {posts.length} 件
    </p>
    <h1>
      #{tag}
    </h1>
  </section>
  
  <!-- 記事一覧 -->
  <div class="post-list">
    {posts.map((post) => {
      const formattedDate = formatPostDate(post.data.pubDate);
      const readingTime = getReadingTime(post);
      
      return (
        <article class="post-list-item">
          <a href={getPostPath(post)} class="post-list-link">
            <div class="post-meta-line">
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              <span class="post-reading">{readingTime}</span>
            </div>

            <div>
              <h3>
                {post.data.title}
              </h3>
              <p>
                {post.data.description}
              </p>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</BaseLayout>
