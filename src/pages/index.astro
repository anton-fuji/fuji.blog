---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DigitalRain from '../components/DigitalRain.astro';
import { formatPostDate, getPostPath, getPublishedPosts, getReadingTime } from '../lib/posts';

const posts = getPublishedPosts(await getCollection('posts'), 'ja');
---

<BaseLayout title="fuji.blog" lang="ja" jaPath="/" enPath="/en">
  <section class="home-page">
    <div class="home-frame rain-frame">
      <DigitalRain />
      <div class="home-intro home-hero">
        <section class="hero" aria-label="Introduction">
        <div class="hero__body">
          <img class="hero__profile" src="/profile-ascii-transparent.png" alt="" />
          <div class="hero__text">
            <p class="hero__lead">fuji.blog</p>
            <p
              class="hero__tagline"
              data-i18n-ja="気軽に更新していく予定〜〜"
              data-i18n-en="Planning to post casually from time to time."
            >気軽に更新していく予定〜〜</p>
          </div>
          <div class="connect-icons" aria-label="Links">
            <a href="https://github.com/anton-fuji" aria-label="GitHub" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.77-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.41 3-.41s2.04.14 3 .41c2.3-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.7.8.58A12.02 12.02 0 0 0 24 12C24 5.37 18.63 0 12 0Z"/></svg></a>
            <a href="/rss.xml" aria-label="RSS"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="3.5" cy="20.5" r="3.5"/><path d="M0 8a16 16 0 0 1 16 16h-4A12 12 0 0 0 0 12V8Z"/><path d="M0 0a24 24 0 0 1 24 24h-4A20 20 0 0 0 0 4V0Z"/></svg></a>
          </div>
        </div>
        </section>
      </div>

      <div class="section-heading">
        <h2>Recent writing</h2>
      </div>
      <div class="post-list">
      {posts.map((post, index) => {
        const formattedDate = formatPostDate(post.data.pubDate);
        const readingTime = getReadingTime(post);
        
        return (
          <article class="post-list-item" style={`--post-index: '${String(index + 1).padStart(2, '0')}'`}>
            <a href={getPostPath(post)} class="post-list-link">
              <div class="post-meta-line">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                <span class="post-reading">{readingTime}</span>
              </div>
              <div class="post-copy">
                <h3>
                  {post.data.title}
                </h3>
                <p>
                  {post.data.description}
                </p>
              </div>
            </a>
          </article>
        );
      })}
      </div>
    </div>
  </section>
</BaseLayout>
