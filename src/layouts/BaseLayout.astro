---
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
  jaPath?: string;
  enPath?: string;
}

const {
  title,
  description = 'fuji.blog',
  lang = 'ja',
  jaPath = Astro.url.pathname,
  enPath,
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = normalizedPath === '/' || normalizedPath === '/en';
const isAbout = normalizedPath === '/about' || normalizedPath === '/en/about';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- OGタグ -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Twitterカード -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (() => {
        const storedLanguage = (() => {
          try {
            return localStorage.getItem('language');
          } catch {
            return null;
          }
        })();
        const storedTheme = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;

        if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }

        const initialLanguage = document.documentElement.lang || storedLanguage || 'ja';
        document.documentElement.dataset.language = initialLanguage;
      })();
    </script>

    <slot name="head"/>
  </head>
  <body class="bg-stone-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors flex flex-col">
    <header class="sticky top-0 z-50 border-b border-zinc-200/60 bg-[#fdfcf9]/88 backdrop-blur-xl dark:border-zinc-800/70 dark:bg-[#111113]/88">
      <nav class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center gap-4">
        <a href={lang === 'en' ? '/en' : '/'} class="font-mono text-sm font-semibold text-zinc-800 transition-colors hover:text-zinc-600 dark:text-zinc-100 dark:hover:text-zinc-300">
          fuji.blog
        </a>
        
        <div class="flex items-center gap-3 sm:gap-5">
          <a
            href={lang === 'en' ? '/en' : '/'}
            class:list={[
              'font-mono text-xs uppercase transition-colors',
              isHome
                ? 'text-zinc-800 dark:text-zinc-100'
                : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300',
            ]}
            data-i18n-ja="Home"
            data-i18n-en="Home"
          >
            Home
          </a>
          <a
            href={lang === 'en' ? '/en/about' : '/about'}
            class:list={[
              'font-mono text-xs uppercase transition-colors',
              isAbout
                ? 'text-zinc-800 dark:text-zinc-100'
                : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300',
            ]}
            data-i18n-ja="About"
            data-i18n-en="About"
          >
            About
          </a>
          <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="text-zinc-500 transition-colors hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300" aria-label="RSS">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"></path>
              <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z"></path>
            </svg>
          </a>
          <LanguageToggle lang={lang} jaPath={jaPath} enPath={enPath} />
          <ThemeToggle />
        </div>
      </nav>
    </header>
    
    <main class="max-w-4xl mx-auto px-4 py-12 sm:py-16 w-full flex-1">
      <slot />
    </main>
    
    <footer class="border-t border-zinc-200/70 dark:border-zinc-800/80">
      <div class="max-w-4xl mx-auto px-4 py-5">
        <div class="text-center">
          <p class="text-xs text-zinc-500 dark:text-zinc-500">
            © 2026 fuji.blog
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
