---
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
  jaPath?: string;
  enPath?: string;
}

const {
  title,
  description = 'fuji.blog',
  lang = 'ja',
  jaPath = Astro.url.pathname,
  enPath,
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = normalizedPath === '/' || normalizedPath === '/en';
const isAbout = normalizedPath === '/about' || normalizedPath === '/en/about';
---

<!DOCTYPE html>
<html lang={lang} data-theme="fuji-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- OGタグ -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Twitterカード -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (() => {
        const storedLanguage = (() => {
          try {
            return localStorage.getItem('language');
          } catch {
            return null;
          }
        })();
        const storedTheme = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const theme = storedTheme === 'light' ? 'light' : 'dark';
        document.documentElement.classList.add(theme);
        document.documentElement.dataset.theme = theme === 'light' ? 'fuji-light' : 'fuji-dark';

        const initialLanguage = document.documentElement.lang || storedLanguage || 'ja';
        document.documentElement.dataset.language = initialLanguage;
      })();
    </script>

    <slot name="head"/>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <header class="site-header">
      <nav class="site-nav navbar">
        <a href={lang === 'en' ? '/en' : '/'} class="site-logo">
          fuji.blog
        </a>
        
        <div class="flex items-center gap-3 sm:gap-5">
          <button class="header-search btn btn-ghost btn-sm" type="button" aria-label="Search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Search</span>
            <kbd>⌘ K</kbd>
          </button>
          <a
            href={lang === 'en' ? '/en' : '/'}
            class:list={[
              'nav-link',
              isHome
                ? 'is-active'
                : '',
            ]}
            data-i18n-ja="Home"
            data-i18n-en="Home"
          >
            Home
          </a>
          <a
            href={lang === 'en' ? '/en/about' : '/about'}
            class:list={[
              'nav-link',
              isAbout
                ? 'is-active'
                : '',
            ]}
            data-i18n-ja="About"
            data-i18n-en="About"
          >
            About
          </a>
          <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="nav-icon" aria-label="RSS">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"></path>
              <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z"></path>
            </svg>
          </a>
          <LanguageToggle lang={lang} jaPath={jaPath} enPath={enPath} />
          <ThemeToggle />
          <div class="header-menu-wrap">
            <button class="header-menu btn btn-ghost btn-square btn-sm" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
            <div class="header-dropdown" role="menu">
              <section class="menu-group">
                <p>Site</p>
                <div class="menu-theme" aria-label="Theme preference">
                  <button class="btn btn-ghost btn-square btn-sm" type="button" data-theme-mode="light" aria-label="Use light theme" title="Light theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></button>
                  <button class="btn btn-ghost btn-square btn-sm" type="button" data-theme-mode="dark" aria-label="Use dark theme" title="Dark theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.99 12.49A9 9 0 1 1 11.51 3a7 7 0 0 0 9.48 9.49Z"/></svg></button>
                </div>
              </section>
              <section class="menu-group">
                <p>Writing</p>
                <a href={lang === 'en' ? '/en' : '/'} role="menuitem">Tags</a>
              </section>
              <section class="menu-group">
                <p>More</p>
                <a href={lang === 'en' ? '/en/about' : '/about'} role="menuitem">About</a>
                <a href="https://github.com/anton-fuji" target="_blank" rel="noopener noreferrer" role="menuitem">GitHub</a>
              </section>
            </div>
          </div>
        </div>
      </nav>
    </header>
    
    <main class="site-main">
      <slot />
    </main>
    
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>© 2026 <a href={lang === 'en' ? '/en' : '/'}>Kazuki Fujimoto</a></p>
        <div class="footer-links">
          <a href={lang === 'en' ? '/en/about' : '/about'}>about</a>
          <span>·</span>
          <a href="/rss.xml">rss</a>
        </div>
      </div>
    </footer>
    <div id="search-dialog" class="search-dialog modal modal-top" hidden>
      <button class="search-backdrop modal-backdrop" type="button" aria-label="Close search"></button>
      <section class="search-panel modal-box" role="dialog" aria-modal="true" aria-labelledby="search-title">
        <div class="search-field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="search-input" class="input input-ghost" type="search" placeholder="Search posts…" autocomplete="off" />
          <button id="search-close" class="btn btn-ghost btn-xs" type="button">Esc</button>
        </div>
        <p id="search-title" class="search-label">Recent posts</p>
        <div id="search-results" class="search-results"></div>
      </section>
    </div>
    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        const menu = document.querySelector('.header-menu-wrap');
        const button = document.querySelector('.header-menu');
        if (header instanceof HTMLElement && menu instanceof HTMLElement && button instanceof HTMLButtonElement) {
          let closeTimer;
          const open = () => { clearTimeout(closeTimer); header.classList.add('menu-open'); button.setAttribute('aria-expanded', 'true'); };
          const close = () => { closeTimer = setTimeout(() => { header.classList.remove('menu-open'); button.setAttribute('aria-expanded', 'false'); }, 240); };
          menu.addEventListener('mouseenter', open);
          menu.addEventListener('mouseleave', close);
          button.addEventListener('click', () => header.classList.contains('menu-open') ? close() : open());
          menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { clearTimeout(closeTimer); }));
          menu.querySelectorAll('[data-theme-mode]').forEach((control) => control.addEventListener('click', () => {
            const mode = control.getAttribute('data-theme-mode');
            if (mode !== 'light' && mode !== 'dark') return;
            document.documentElement.classList.toggle('dark', mode === 'dark');
            document.documentElement.classList.toggle('light', mode === 'light');
            document.documentElement.dataset.theme = mode === 'light' ? 'fuji-light' : 'fuji-dark';
            try { localStorage.setItem('theme', mode); } catch {}
          }));
        }

        const trigger = document.querySelector('.header-search');
        const dialog = document.getElementById('search-dialog');
        const input = document.getElementById('search-input');
        const results = document.getElementById('search-results');
        const closeSearch = () => { dialog?.classList.remove('modal-open'); dialog?.setAttribute('hidden', ''); };
        const openSearch = () => { dialog?.removeAttribute('hidden'); dialog?.classList.add('modal-open'); setTimeout(() => input?.focus(), 0); };
        let posts = [];
        const render = (query = '') => {
          if (!(results instanceof HTMLElement)) return;
          const language = location.pathname.startsWith('/en') ? 'en' : 'ja';
          const needle = query.trim().toLocaleLowerCase();
          const matches = posts.filter((post) => post.lang === language && (!needle || [post.title, post.description, ...post.tags].join(' ').toLocaleLowerCase().includes(needle))).slice(0, 8);
          results.replaceChildren();
          if (!matches.length) { results.textContent = 'No matching posts.'; return; }
          matches.forEach((post) => {
            const link = document.createElement('a'); link.href = post.href;
            const title = document.createElement('strong'); title.textContent = post.title;
            const description = document.createElement('span'); description.textContent = post.description;
            link.append(title, description); results.append(link);
          });
        };
        trigger?.addEventListener('click', async () => {
          openSearch();
          if (!posts.length) { posts = await fetch('/search.json').then((response) => response.json()); }
          render();
        });
        input?.addEventListener('input', () => render(input.value));
        dialog?.querySelectorAll('.search-backdrop, #search-close').forEach((element) => element.addEventListener('click', closeSearch));
        addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); trigger?.click(); }
          if (event.key === 'Escape') closeSearch();
        });
      })();
    </script>
  </body>
</html>
