---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostBadge from '../components/PostBadge.astro';
import { formatPostDate, getReadingTime } from '../lib/posts';

type Props = CollectionEntry<'posts'>['data'] & {
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  post: CollectionEntry<'posts'>;
  lang?: 'ja' | 'en';
  jaPath?: string;
  enPath?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  slug,
  headings = [],
  post,
  lang = 'ja',
  jaPath,
  enPath,
} = Astro.props;

const formattedDate = formatPostDate(pubDate);

const formattedUpdatedDate = updatedDate
  ? formatPostDate(updatedDate)
  : null;

const readingTime = getReadingTime(post);
const postPath = lang === 'en' ? `/en/posts/${slug}` : `/posts/${slug}`;
const ogImagePath = lang === 'en' ? `/og/en/${slug}.png` : `/og/${slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).href;

// X共有用のURL
const postUrl = new URL(postPath, Astro.site ?? Astro.url).href;
const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl)}`;
---

<BaseLayout title={title} description={description} lang={lang} jaPath={jaPath} enPath={enPath}>
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" property="og:image" content={ogImageUrl} />
  <meta slot="head" property="og:url" content={Astro.url.href} />
  <meta slot="head" name="twitter:image" content={ogImageUrl} />
  
  <div class="article-frame">
    <div class="article-layout">
      <article class="article">
      <header class="article-header">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/en' : '/'}>home</a>
          <span>/</span>
          <span>posts</span>
        </nav>
        <div class="article-info">
          <time datetime={pubDate.toISOString()}>
            {formattedDate}
          </time>

          {formattedUpdatedDate && (
            <span
              data-i18n-ja={`更新 ${formattedUpdatedDate}`}
              data-i18n-en={`Updated ${formattedUpdatedDate}`}
            >
              Updated {formattedUpdatedDate}
            </span>
          )}

          <PostBadge label={readingTime} kind="meta" />
        </div>

        <h1>
          {title}
        </h1>

        {description && (
          <p class="article-description">
            {description}
          </p>
        )}

        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <PostBadge
                href={lang === 'en' ? `/en/tags/${tag}` : `/tags/${tag}`}
                label={tag}
              />
            ))}
          </div>
        )}
      </header>

      {headings.length > 0 && (
        <details class="article-toc">
          <summary data-i18n-ja="目次" data-i18n-en="Contents">Contents</summary>
          <nav aria-label="Table of contents">
            <ul>
              {headings.map((heading) => (
                <li style={`padding-left: ${(heading.depth - 1) * 12}px`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}
      
      <div class="prose article-content">
        <slot />
      </div>
      <div class="article-share">
        <a 
          href={shareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-link"
        >
          <span data-i18n-ja="共有" data-i18n-en="Share on">Share on</span>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
      </article>
    </div>
  </div>

  <script>
    const languageNames: Record<string, string> = {
      bash: 'Shell',
      css: 'CSS',
      html: 'HTML',
      javascript: 'JavaScript',
      js: 'JavaScript',
      json: 'JSON',
      jsx: 'JSX',
      markdown: 'Markdown',
      md: 'Markdown',
      sh: 'Shell',
      shell: 'Shell',
      ts: 'TypeScript',
      tsx: 'TSX',
      typescript: 'TypeScript',
      yaml: 'YAML',
      yml: 'YAML',
    };

    const copyLabel = document.documentElement.lang === 'ja' ? 'コピー' : 'Copy';
    const copiedLabel = document.documentElement.lang === 'ja' ? 'コピー済み' : 'Copied';
    const failedLabel = document.documentElement.lang === 'ja' ? 'コピーに失敗' : 'Copy failed';
    const copyIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="1.5"></rect><path d="M16 8V6.5A1.5 1.5 0 0 0 14.5 5h-8A1.5 1.5 0 0 0 5 6.5v8A1.5 1.5 0 0 0 6.5 16H8"></path></svg>';
    const checkIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5"></path></svg>';
    const failedIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v6M12 17.2v.1"></path><circle cx="12" cy="12" r="8.5"></circle></svg>';

    document.querySelectorAll<HTMLElement>('.article-content pre[data-language]').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const code = pre.querySelector('code');
      if (!code) return;

      const language = pre.dataset.language ?? 'text';
      const wrapper = document.createElement('div');
      const header = document.createElement('div');
      const label = document.createElement('span');
      const copyButton = document.createElement('button');

      wrapper.className = 'code-block';
      header.className = 'code-block__header';
      label.className = 'code-block__language';
      label.textContent = languageNames[language.toLowerCase()] ?? language;
      copyButton.className = 'code-block__copy';
      copyButton.type = 'button';
      copyButton.setAttribute('aria-label', `${copyLabel}: ${label.textContent}`);

      const setCopyState = (state: 'idle' | 'copied' | 'failed') => {
        const icon = state === 'copied' ? checkIcon : state === 'failed' ? failedIcon : copyIcon;
        const labelText = state === 'copied' ? copiedLabel : state === 'failed' ? failedLabel : copyLabel;
        copyButton.innerHTML = icon;
        copyButton.dataset.state = state;
        copyButton.setAttribute('aria-label', `${labelText}: ${label.textContent}`);
        copyButton.title = labelText;
      };

      setCopyState('idle');

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          setCopyState('copied');
          window.setTimeout(() => {
            setCopyState('idle');
          }, 1600);
        } catch {
          setCopyState('failed');
          window.setTimeout(() => {
            setCopyState('idle');
          }, 1600);
        }
      });

      header.append(label, copyButton);
      pre.replaceWith(wrapper);
      wrapper.append(header, pre);
    });
  </script>
</BaseLayout>
