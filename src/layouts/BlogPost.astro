---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostBadge from '../components/PostBadge.astro';
import { formatPostDate, getPostPath, getReadingTime } from '../lib/posts';

type Props = CollectionEntry<'posts'>['data'] & {
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  post: CollectionEntry<'posts'>;
  newerPost?: CollectionEntry<'posts'>;
  olderPost?: CollectionEntry<'posts'>;
  lang?: 'ja' | 'en';
  jaPath?: string;
  enPath?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  slug,
  headings = [],
  post,
  newerPost,
  olderPost,
  lang = 'ja',
  jaPath,
  enPath,
} = Astro.props;

const formattedDate = formatPostDate(pubDate);

const formattedUpdatedDate = updatedDate
  ? formatPostDate(updatedDate)
  : null;

const readingTime = getReadingTime(post);
const postPath = lang === 'en' ? `/en/posts/${slug}` : `/posts/${slug}`;
const ogImagePath = lang === 'en' ? `/og/en/${slug}.png` : `/og/${slug}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).href;

// X共有用のURL
const postUrl = new URL(postPath, Astro.site ?? Astro.url).href;
const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl)}`;
const hasSingleAdjacentPost = Boolean(newerPost) !== Boolean(olderPost);
---

<BaseLayout title={title} description={description} lang={lang} jaPath={jaPath} enPath={enPath}>
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" property="og:image" content={ogImageUrl} />
  <meta slot="head" property="og:url" content={Astro.url.href} />
  <meta slot="head" name="twitter:image" content={ogImageUrl} />
  
  <div class="article-frame">
    <div class="article-layout">
      {headings.length > 0 && (
        <aside class="article-toc article-toc--desktop" aria-label={lang === 'en' ? 'Table of contents' : '目次'}>
          <div class="article-toc__heading">
            <span data-i18n-ja="目次" data-i18n-en="Contents">Contents</span>
            <span class="article-toc__progress" data-toc-progress>0%</span>
          </div>
          <nav>
            <ul>
              {headings.map((heading) => (
                <li class:list={[heading.depth > 2 && 'article-toc__item--nested']}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      <article class="article">
      <header class="article-header">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/en' : '/'}>home</a>
          <span>/</span>
          <span>posts</span>
        </nav>
        <div class="article-info">
          <time datetime={pubDate.toISOString()}>
            {formattedDate}
          </time>

          {formattedUpdatedDate && (
            <span
              data-i18n-ja={`更新 ${formattedUpdatedDate}`}
              data-i18n-en={`Updated ${formattedUpdatedDate}`}
            >
              Updated {formattedUpdatedDate}
            </span>
          )}

          <PostBadge label={readingTime} kind="meta" />
        </div>

        <h1>
          {title}
        </h1>

        {description && (
          <p class="article-description">
            {description}
          </p>
        )}

        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <PostBadge
                href={lang === 'en' ? `/en/tags/${tag}` : `/tags/${tag}`}
                label={tag}
              />
            ))}
          </div>
        )}
      </header>

      {headings.length > 0 && (
        <details class="article-toc article-toc--mobile">
          <summary>
            <span data-i18n-ja="目次" data-i18n-en="Contents">Contents</span>
            <span class="article-toc__summary-meta">
              <span class="article-toc__count">{lang === 'en' ? `${headings.length} sections` : `${headings.length}項目`}</span>
              <span data-toc-progress>0%</span>
              <span class="article-toc__indicator" aria-hidden="true"></span>
            </span>
          </summary>
          <nav aria-label="Table of contents">
            <ul>
              {headings.map((heading) => (
                <li class:list={[heading.depth > 2 && 'article-toc__item--nested']}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}
      
      <div class="prose article-content">
        <slot />
      </div>
      <div class="article-share">
        <a 
          href={shareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-link"
        >
          <span data-i18n-ja="共有" data-i18n-en="Share on">Share on</span>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <button
          class="share-link share-link--copy"
          type="button"
          data-copy-post-link={postUrl}
          aria-label={lang === 'en' ? 'Copy link' : 'リンクをコピー'}
        >
          <span data-share-copy-label>{lang === 'en' ? 'Copy link' : 'リンクをコピー'}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="1.5"></rect><path d="M16 8V6.5A1.5 1.5 0 0 0 14.5 5h-8A1.5 1.5 0 0 0 5 6.5v8A1.5 1.5 0 0 0 6.5 16H8"></path></svg>
        </button>
        <span class="share-copy-status" data-share-copy-status aria-live="polite"></span>
      </div>

      {(newerPost || olderPost) && (
        <nav class="article-pagination" aria-label={lang === 'en' ? 'Post navigation' : '記事ナビゲーション'}>
          <p class="article-pagination__label">{lang === 'en' ? 'Continue reading' : '次に読む'}</p>
          <div class:list={['article-pagination__links', hasSingleAdjacentPost && 'article-pagination__links--single']}>
            {newerPost ? (
              <a class="article-pagination__link" data-article-nav="newer" href={getPostPath(newerPost)}>
                <span>{lang === 'en' ? '← Newer entry' : '← 新しい記事'}</span>
                <strong>{newerPost.data.title}</strong>
              </a>
            ) : null}
            {olderPost ? (
              <a class:list={['article-pagination__link', newerPost && 'article-pagination__link--right']} data-article-nav="older" href={getPostPath(olderPost)}>
                <span>{lang === 'en' ? 'Older entry →' : '古い記事 →'}</span>
                <strong>{olderPost.data.title}</strong>
              </a>
            ) : null}
          </div>
        </nav>
      )}

      <button class="article-shortcuts-trigger" type="button" data-article-shortcuts-open aria-haspopup="dialog">
        {lang === 'en' ? '? Shortcuts' : '? ショートカット'}
      </button>
      </article>
    </div>
  </div>

  <div id="article-shortcuts-dialog" class="article-shortcuts-dialog" hidden>
    <button class="article-shortcuts-dialog__backdrop" type="button" data-article-shortcuts-close aria-label={lang === 'en' ? 'Close shortcuts' : 'ショートカットを閉じる'}></button>
    <section class="article-shortcuts-dialog__panel" role="dialog" aria-modal="true" aria-labelledby="article-shortcuts-title" tabindex="-1">
      <div class="article-shortcuts-dialog__header">
        <p id="article-shortcuts-title">{lang === 'en' ? 'Keyboard shortcuts' : 'キーボードショートカット'}</p>
        <button type="button" data-article-shortcuts-close aria-label={lang === 'en' ? 'Close shortcuts' : 'ショートカットを閉じる'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <dl class="article-shortcuts-dialog__list">
        <div><dt><kbd>j</kbd> / <kbd>k</kbd></dt><dd>{lang === 'en' ? 'Next / previous heading' : '次／前の見出しへ'}</dd></div>
        <div><dt><kbd>g</kbd> / <kbd>G</kbd></dt><dd>{lang === 'en' ? 'Top / bottom of article' : '記事の先頭／末尾へ'}</dd></div>
        <div><dt><kbd>h</kbd> / <kbd>l</kbd></dt><dd>{lang === 'en' ? 'Newer / older entry' : '新しい／古い記事へ'}</dd></div>
        <div><dt><kbd>/</kbd></dt><dd>{lang === 'en' ? 'Open search' : '検索を開く'}</dd></div>
      </dl>
    </section>
  </div>

  <script>
    const languageNames: Record<string, string> = {
      bash: 'Shell',
      css: 'CSS',
      html: 'HTML',
      javascript: 'JavaScript',
      js: 'JavaScript',
      json: 'JSON',
      jsx: 'JSX',
      markdown: 'Markdown',
      md: 'Markdown',
      sh: 'Shell',
      shell: 'Shell',
      ts: 'TypeScript',
      tsx: 'TSX',
      typescript: 'TypeScript',
      yaml: 'YAML',
      yml: 'YAML',
    };

    const copyLabel = document.documentElement.lang === 'ja' ? 'コピー' : 'Copy';
    const copiedLabel = document.documentElement.lang === 'ja' ? 'コピー済み' : 'Copied';
    const failedLabel = document.documentElement.lang === 'ja' ? 'コピーに失敗' : 'Copy failed';
    const copyIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="1.5"></rect><path d="M16 8V6.5A1.5 1.5 0 0 0 14.5 5h-8A1.5 1.5 0 0 0 5 6.5v8A1.5 1.5 0 0 0 6.5 16H8"></path></svg>';
    const checkIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5"></path></svg>';
    const failedIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v6M12 17.2v.1"></path><circle cx="12" cy="12" r="8.5"></circle></svg>';

    document.querySelectorAll<HTMLElement>('.article-content pre[data-language]').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const code = pre.querySelector('code');
      if (!code) return;

      const language = pre.dataset.language ?? 'text';
      const wrapper = document.createElement('div');
      const header = document.createElement('div');
      const label = document.createElement('span');
      const copyButton = document.createElement('button');

      wrapper.className = 'code-block';
      header.className = 'code-block__header';
      label.className = 'code-block__language';
      label.textContent = languageNames[language.toLowerCase()] ?? language;
      copyButton.className = 'code-block__copy';
      copyButton.type = 'button';
      copyButton.setAttribute('aria-label', `${copyLabel}: ${label.textContent}`);

      const setCopyState = (state: 'idle' | 'copied' | 'failed') => {
        const icon = state === 'copied' ? checkIcon : state === 'failed' ? failedIcon : copyIcon;
        const labelText = state === 'copied' ? copiedLabel : state === 'failed' ? failedLabel : copyLabel;
        copyButton.innerHTML = `${icon}<span class="code-block__copy-label">${labelText}</span>`;
        copyButton.dataset.state = state;
        copyButton.setAttribute('aria-label', `${labelText}: ${label.textContent}`);
        copyButton.title = labelText;
      };

      setCopyState('idle');

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          setCopyState('copied');
          window.setTimeout(() => {
            setCopyState('idle');
          }, 1600);
        } catch {
          setCopyState('failed');
          window.setTimeout(() => {
            setCopyState('idle');
          }, 1600);
        }
      });

      header.append(label, copyButton);
      pre.replaceWith(wrapper);
      wrapper.append(header, pre);
    });

    const postLinkCopyButton = document.querySelector<HTMLButtonElement>('[data-copy-post-link]');
    const postLinkCopyLabel = document.querySelector<HTMLElement>('[data-share-copy-label]');
    const postLinkCopyStatus = document.querySelector<HTMLElement>('[data-share-copy-status]');
    const postLinkLabel = document.documentElement.lang === 'ja' ? 'リンクをコピー' : 'Copy link';
    const postLinkCopiedLabel = document.documentElement.lang === 'ja' ? 'コピーしました' : 'Copied';
    const postLinkFailedLabel = document.documentElement.lang === 'ja' ? 'コピーに失敗しました' : 'Copy failed';

    const setPostLinkCopyState = (state: 'idle' | 'copied' | 'failed') => {
      if (!postLinkCopyButton || !postLinkCopyLabel) return;
      const label = state === 'copied' ? postLinkCopiedLabel : state === 'failed' ? postLinkFailedLabel : postLinkLabel;
      postLinkCopyButton.dataset.state = state;
      postLinkCopyButton.setAttribute('aria-label', label);
      postLinkCopyButton.title = label;
      postLinkCopyLabel.textContent = label;
      if (postLinkCopyStatus) postLinkCopyStatus.textContent = state === 'idle' ? '' : label;
    };

    postLinkCopyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(postLinkCopyButton.dataset.copyPostLink ?? window.location.href);
        setPostLinkCopyState('copied');
      } catch {
        setPostLinkCopyState('failed');
      }
      window.setTimeout(() => setPostLinkCopyState('idle'), 1600);
    });

    const article = document.querySelector<HTMLElement>('.article');
    const shortcutsDialog = document.getElementById('article-shortcuts-dialog');
    const shortcutsPanel = shortcutsDialog?.querySelector<HTMLElement>('.article-shortcuts-dialog__panel');
    const shortcutsTriggers = document.querySelectorAll<HTMLButtonElement>('[data-article-shortcuts-open]');
    const newerArticleLink = document.querySelector<HTMLAnchorElement>('[data-article-nav="newer"]');
    const olderArticleLink = document.querySelector<HTMLAnchorElement>('[data-article-nav="older"]');
    const articleHeadings = [...document.querySelectorAll<HTMLElement>('.article-content h2, .article-content h3')];
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const tocProgresses = [...document.querySelectorAll<HTMLElement>('[data-toc-progress]')];
    const articleContent = document.querySelector<HTMLElement>('.article-content');
    const articleLayout = document.querySelector<HTMLElement>('.article-layout');
    const articleTitle = document.querySelector<HTMLElement>('.article-header h1');
    const desktopToc = document.querySelector<HTMLElement>('.article-toc--desktop');
    const desktopTocBreakpoint = window.matchMedia('(min-width: 1040px)');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isEditableTarget = (target: EventTarget | null) => target instanceof HTMLElement && (
      target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
    );
    const scrollToPosition = (top: number) => {
      window.scrollTo({ top: Math.max(0, top), behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    };
    const closeShortcuts = () => {
      shortcutsDialog?.setAttribute('hidden', '');
      shortcutsTriggers[0]?.focus();
    };
    const openShortcuts = () => {
      shortcutsDialog?.removeAttribute('hidden');
      window.setTimeout(() => shortcutsPanel?.querySelector<HTMLElement>('[data-article-shortcuts-close]')?.focus(), 0);
    };
    shortcutsTriggers.forEach((trigger) => trigger.addEventListener('click', openShortcuts));
    shortcutsDialog?.querySelectorAll('[data-article-shortcuts-close]').forEach((closeButton) => {
      closeButton.addEventListener('click', closeShortcuts);
    });
    const moveHeading = (direction: 1 | -1) => {
      const headingOffset = 24;
      const currentPosition = window.scrollY + headingOffset;
      const candidates = direction === 1
        ? articleHeadings.filter((heading) => heading.offsetTop > currentPosition + 4)
        : articleHeadings.filter((heading) => heading.offsetTop < currentPosition - 4);
      const target = direction === 1 ? candidates[0] : candidates.at(-1);
      if (target) scrollToPosition(target.offsetTop - headingOffset);
    };

    const updateToc = () => {
      if (!articleContent || articleHeadings.length === 0) return;

      const activeHeading = articleHeadings.reduce<HTMLElement | undefined>((current, heading) => (
        heading.getBoundingClientRect().top <= 112 ? heading : current
      ), undefined) ?? articleHeadings[0];
      const activeId = activeHeading.id;

      tocLinks.forEach((link) => {
        const isActive = link.dataset.tocLink === activeId;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      const scrollableHeight = Math.max(1, articleContent.offsetHeight - window.innerHeight);
      const progress = Math.round(Math.min(1, Math.max(0, (window.scrollY - articleContent.offsetTop) / scrollableHeight)) * 100);
      tocProgresses.forEach((element) => { element.textContent = `${progress}%`; });
    };

    const alignDesktopToc = () => {
      if (!articleLayout || !articleTitle || !desktopToc) return;
      if (!desktopTocBreakpoint.matches) {
        desktopToc.style.removeProperty('margin-top');
        return;
      }

      const titleOffset = articleTitle.getBoundingClientRect().top - articleLayout.getBoundingClientRect().top;
      desktopToc.style.marginTop = `${Math.max(0, titleOffset)}px`;
    };

    let tocFrame = 0;
    const requestTocUpdate = () => {
      if (tocFrame) return;
      tocFrame = requestAnimationFrame(() => {
        alignDesktopToc();
        updateToc();
        tocFrame = 0;
      });
    };
    alignDesktopToc();
    updateToc();
    addEventListener('scroll', requestTocUpdate, { passive: true });
    addEventListener('resize', requestTocUpdate);

    addEventListener('keydown', (event) => {
      if (!article || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.isComposing) return;
      if (!shortcutsDialog?.hasAttribute('hidden')) {
        if (event.key === 'Escape') { event.preventDefault(); closeShortcuts(); }
        if (event.key === 'Tab' && shortcutsPanel) {
          const focusable = [...shortcutsPanel.querySelectorAll<HTMLElement>('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')];
          const first = focusable[0];
          const last = focusable.at(-1);
          if (first && last) {
            const activeElement = document.activeElement;
            if (event.shiftKey && (activeElement === first || !shortcutsPanel.contains(activeElement))) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && (activeElement === last || !shortcutsPanel.contains(activeElement))) {
              event.preventDefault();
              first.focus();
            }
          }
        }
        return;
      }
      if (isEditableTarget(event.target)) return;
      if (!document.getElementById('search-dialog')?.hasAttribute('hidden')) return;
      if (event.key === '?') { event.preventDefault(); openShortcuts(); return; }
      if (event.target instanceof HTMLButtonElement || event.target instanceof HTMLAnchorElement) return;

      if (event.key === 'j') { event.preventDefault(); moveHeading(1); }
      if (event.key === 'k') { event.preventDefault(); moveHeading(-1); }
      if (event.key === 'g') { event.preventDefault(); scrollToPosition(article.offsetTop - 24); }
      if (event.key === 'G') { event.preventDefault(); scrollToPosition(article.offsetTop + article.offsetHeight - window.innerHeight + 24); }
      if (event.key === 'h' && newerArticleLink) { event.preventDefault(); window.location.assign(newerArticleLink.href); }
      if (event.key === 'l' && olderArticleLink) { event.preventDefault(); window.location.assign(olderArticleLink.href); }
    });
  </script>
</BaseLayout>
