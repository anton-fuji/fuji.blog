{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "astro": true,
    "browser": true,
    "node": true
  },
  "plugins": ["import"],
  "rules": {
    "eqeqeq": "error",
    "no-console": "warn",
    "no-throw-literal": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs}"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
